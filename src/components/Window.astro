---
// A Mac-style window. `active` gives it the vermilion title bar,
// `scroll` adds the decorative dithered scrollbar on the right.
interface Props {
  title: string;
  active?: boolean;
  close?: boolean;
  scroll?: boolean;
  id?: string;
  class?: string;
}
const { title, active = false, close = true, scroll = false, id, class: cls = '' } = Astro.props;
---
<section id={id} class:list={['window', { 'window--active': active }, cls]} aria-label={title}>
  <div class="window__bar">
    {close && <span class="window__close" aria-hidden="true"></span>}
    <span class="window__title">{title}</span>
  </div>
  <slot name="info" />
  {scroll ? (
    <div class="window__scrollable">
      <div><slot /></div>
      <div class="scrollbar" aria-hidden="true">
        <span>▲</span><span class="scrollbar__track"><span class="scrollbar__thumb"></span></span><span>▼</span>
      </div>
    </div>
  ) : (
    <slot />
  )}
</section>
