---
// Small hand-drawn pixel icons (16×16 grid). Add your own here.
interface Props { name: 'github' | 'linkedin' | 'rss' | 'x' | 'logo' | 'alert' }
const { name } = Astro.props;
const ink = 'var(--ink)';
---
{name === 'github' && (
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <rect x="2" y="1" width="5" height="5" fill={ink} /><rect x="3" y="2" width="3" height="3" fill="var(--sage)" />
    <rect x="2" y="10" width="5" height="5" fill={ink} /><rect x="3" y="11" width="3" height="3" fill="var(--sage)" />
    <rect x="10" y="3" width="5" height="5" fill={ink} /><rect x="11" y="4" width="3" height="3" fill="var(--butter)" />
    <rect x="4" y="6" width="1" height="4" fill={ink} /><rect x="12" y="8" width="1" height="3" fill={ink} /><rect x="7" y="10" width="6" height="1" fill={ink} />
  </svg>
)}
{name === 'linkedin' && (
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <rect x="1" y="3" width="14" height="10" fill={ink} /><rect x="2" y="4" width="12" height="8" fill="var(--lilac)" />
    <rect x="3" y="5" width="4" height="6" fill={ink} /><rect x="4" y="6" width="2" height="2" fill="var(--lilac)" />
    <rect x="8" y="6" width="5" height="1" fill={ink} /><rect x="8" y="8" width="4" height="1" fill={ink} /><rect x="8" y="10" width="3" height="1" fill={ink} />
  </svg>
)}
{name === 'rss' && (
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <rect x="1" y="1" width="14" height="14" fill={ink} /><rect x="2" y="2" width="12" height="12" fill="var(--butter)" />
    <rect x="4" y="10" width="2" height="2" fill={ink} />
    <rect x="4" y="7" width="3" height="1" fill={ink} /><rect x="7" y="8" width="1" height="1" fill={ink} /><rect x="8" y="9" width="1" height="3" fill={ink} />
    <rect x="4" y="4" width="5" height="1" fill={ink} /><rect x="9" y="5" width="1" height="1" fill={ink} /><rect x="10" y="6" width="1" height="1" fill={ink} /><rect x="11" y="7" width="1" height="5" fill={ink} />
  </svg>
)}
{name === 'x' && (
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <rect x="1" y="2" width="14" height="10" fill={ink} /><rect x="2" y="3" width="12" height="8" fill="var(--accent)" />
    <rect x="4" y="6" width="2" height="2" fill={ink} /><rect x="7" y="6" width="2" height="2" fill={ink} /><rect x="10" y="6" width="2" height="2" fill={ink} />
    <rect x="3" y="12" width="4" height="1" fill={ink} /><rect x="3" y="13" width="2" height="1" fill={ink} /><rect x="3" y="14" width="1" height="1" fill={ink} />
  </svg>
)}
{name === 'logo' && (
  <svg viewBox="0 0 10 10" class="menubar__logo" aria-hidden="true" style="shape-rendering: crispEdges">
    <rect x="1" y="1" width="8" height="8" fill={ink} /><rect x="3" y="3" width="4" height="4" fill="var(--butter)" />
  </svg>
)}
{name === 'alert' && (
  <svg viewBox="0 0 16 16" width="48" height="48" aria-hidden="true" style="shape-rendering: crispEdges; flex: none">
    <rect x="1" y="1" width="14" height="14" fill={ink} /><rect x="2" y="2" width="12" height="12" fill="var(--butter)" />
    <rect x="7" y="4" width="2" height="5" fill={ink} /><rect x="7" y="10" width="2" height="2" fill={ink} />
  </svg>
)}
